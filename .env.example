# Configuracion de Bus Counter. manage.py crea .env a partir de este archivo
# y rellena las claves vacias con valores aleatorios. .env nunca va a git.

# Servidor web (dashboard)
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# IP que se pone en el certificado y se muestra para otros equipos.
# Vacio = se detecta sola.
ADVERTISED_IP=

# Broker MQTT (el servidor y el simulador se conectan aqui)
MQTT_HOST=127.0.0.1
MQTT_PORT=8883
MQTT_SERVER_USER=servidor
MQTT_SERVER_PASSWORD=

# Buses: un usuario MQTT por bus, con el mismo nombre que el ID.
# Para agregar un bus, suma su ID aqui; su clave se genera sola al arrancar.
BUS_IDS=B01,B02,B03,B04,B05,B06
BUS_PASSWORD_B01=
BUS_PASSWORD_B02=
BUS_PASSWORD_B03=
BUS_PASSWORD_B04=
BUS_PASSWORD_B05=
BUS_PASSWORD_B06=

# Base de datos
DB_PATH=server/data/bus_counter.db
